# Production Environment Configuration Template
# Copy this file to .env or backend/.env when deploying to production

# Server Port (Default: 3000)
PORT=3000

# Node Environment
NODE_ENV=production

# MySQL Database Configuration (Optional - Backend automatically falls back to JSON DB if MySQL is omitted or unreachable)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=svar_db

# Email Notification Configuration (Gmail SMTP or custom provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="SVAR 2026 <your_email@gmail.com>"
